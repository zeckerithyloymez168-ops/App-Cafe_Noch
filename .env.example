# Google Apps Script Web App Deployment URL
VITE_GAS_API_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Shop Info (Optional override)
VITE_SHOP_NAME=Café Artisanal
VITE_TELEGRAM_BOT_USERNAME=MyCoffeeShopBot

# Toggle mock mode if set to true (Default: false when VITE_GAS_API_URL is provided)
VITE_USE_MOCK=false
